# Public OAuth application IDs. These are identifiers, not secrets.
# In Next.js, NEXT_PUBLIC_* values are embedded into browser JavaScript, so
# never put a client secret in this file.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# Base URL of the backend API, including the version prefix.
# Local:      http://localhost:4000/api/v1
# Production: https://your-api-host.example.com/api/v1
#
# Leave empty only to run the browser-local preview. In a production build an
# empty value disables email sign-in instead of pretending it worked.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
