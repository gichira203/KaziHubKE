# Public OAuth application IDs. These are identifiers, not secrets.
# In Next.js, NEXT_PUBLIC_* values are embedded into browser JavaScript.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# API URL for the web app. OAuth is not fully wired until the backend
# implements provider callbacks and exchanges authorization codes securely.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
