# Public OAuth application IDs. These are identifiers, not secrets.
# In Next.js, NEXT_PUBLIC_* values are embedded into browser JavaScript.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=389969343881-852vorepc9256iggfk90gkeauajv5bgr.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=c5570ed6d7122cc5f7179c37de038f7d
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=

# OAuth client secrets belong in backend/.env and must never use NEXT_PUBLIC_.
# Configure the matching redirect URIs in Google/Facebook developer consoles.
# API URL for the web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
