# ---- Server --------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated in production, e.g.
# https://kazihub.example.com,https://www.kazihub.example.com).
WEB_ORIGIN=http://localhost:3000

# Public URL of the web app (OAuth error redirects and callback links).
WEB_URL=http://localhost:3000

# Public URL of this API. Used to build OAuth redirect URIs, so it must match
# exactly what is registered with each provider.
API_PUBLIC_URL=http://localhost:4000

# Signs the session JWT. Required in production — the API refuses to issue
# sessions without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# PostgreSQL connection string. REQUIRED in production; migrations run
# automatically at startup. Example:
#   postgresql://user:password@host:5432/kazihub?sslmode=require
# When unset in development the API uses embedded PGlite under
# backend/data/pglite so `npm run dev` works without installing PostgreSQL.
DATABASE_URL=

# Optional: "require" or "disable". Inferred from the URL otherwise.
PGSSL=

# Bootstrap administrator (only used by `npm run db:seed-admin`). No demo
# jobs, reviews or users are seeded — only this account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ---- OAuth providers (optional) -----------------------------------------
# Register these redirect URIs with the provider consoles:
# Google:   http://localhost:4000/api/v1/auth/oauth/google/callback
# Facebook: http://localhost:4000/api/v1/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_SECRET=
