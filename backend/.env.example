# ---- Server --------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated in production, e.g.
# https://kazihub.example.com,https://www.kazihub.example.com).
WEB_ORIGIN=http://localhost:3000

# Public URL of the web app (OAuth error redirects and callback links).
WEB_URL=http://localhost:3000

# Public URL of this API. Used to build OAuth redirect URIs, so it must match
# exactly what is registered with each provider.
API_PUBLIC_URL=http://localhost:4000

# Signs the session JWT. Required in production — the API refuses to issue
# sessions without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Where accounts are stored. Defaults to backend/data/users.json.
# On Render set this to a file on a mounted persistent disk, e.g.
# /var/data/users.json. Without a disk the file is lost on redeploy.
AUTH_DATA_FILE=

# ---- OAuth providers (optional) -----------------------------------------
# Register these redirect URIs with the provider consoles:
# Google:   http://localhost:4000/api/v1/auth/oauth/google/callback
# Facebook: http://localhost:4000/api/v1/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_SECRET=

# ---- Database (not used yet) --------------------------------------------
# Accounts currently use the JSON file store above. PostgreSQL is planned for
# a later phase; leave this empty until Prisma and a schema are added.
DATABASE_URL=
