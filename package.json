{
  "name": "kazihub-ke",
  "version": "1.0.0",
  "private": true,
  "description": "KaziHub KE job platform — Next.js web app in frontend/ and Express API in backend/.",
  "scripts": {
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "start:backend": "npm --prefix backend start"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neondatabase/serverless": "^1.2.0",
    "pg": "^8.23.1"
  }
}
